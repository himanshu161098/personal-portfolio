{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-chatbot-proxy",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-1.5-flash",
    "CLAUDE_MODEL": "claude-3-7-sonnet-20250219",
    "AI_PROVIDER": "gemini"
  }
}
