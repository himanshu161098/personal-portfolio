# ==============================================================================
# PRACHI AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

PORT=3001
NODE_ENV=production
JWT_SECRET=replace-with-a-strong-random-secret-key-at-least-32-characters
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# REAL TRANSACTIONAL EMAIL PROVIDER & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Supported: 'resend' | 'sendgrid' | 'postmark' | 'brevo' | 'smtp'
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your_transactional_email_api_key_here
EMAIL_FROM=noreply@prachi.ai
EMAIL_FROM_NAME=Prachi AI Security

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email@gmail.com
SMTP_PASS=your_smtp_app_password_or_token

# SMS Settings (Optional for Real Mobile SMS)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# OTP SECURITY & POLICIES
# ------------------------------------------------------------------------------
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate Limiting
RATE_LIMIT_MAX=300

# AI Providers
DEFAULT_AI_PROVIDER=local_heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
