# ==============================================================================
# PRACHI AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env in your root and backend directories before starting.
# NEVER commit real production API keys or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE SETTINGS
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
JWT_SECRET=replace-with-a-strong-random-secret-key-at-least-32-characters
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 2. REAL TRANSACTIONAL EMAIL PROVIDER & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Prachi AI delivers real 6-digit OTP codes for account registration and sign-in.
# Supported EMAIL_PROVIDER options:
#   - 'resend'   (Modern HTTPS transactional email API - https://resend.com)
#   - 'sendgrid' (SendGrid Mail Send API - https://sendgrid.com)
#   - 'postmark' (Postmark Transactional API - https://postmarkapp.com)
#   - 'brevo'    (Brevo / Sendinblue API - https://brevo.com)
#   - 'smtp'     (Standard SMTP: Gmail, AWS SES, Mailgun, Brevo, custom SMTP)
#
# If EMAIL_PROVIDER is not set, it will auto-detect based on API key prefix or SMTP_HOST.
EMAIL_PROVIDER=resend

# API Key for Resend, SendGrid, Postmark, or Brevo (Never expose to browser)
EMAIL_API_KEY=your_transactional_email_api_key_here

# Verified Sender Information (Must be domain-verified in your provider dashboard)
EMAIL_FROM=noreply@prachi.ai
EMAIL_FROM_NAME=Prachi AI Security

# ------------------------------------------------------------------------------
# 3. SMTP SETTINGS (Required only if EMAIL_PROVIDER=smtp)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email@gmail.com
SMTP_PASS=your_smtp_app_password_or_token

# ------------------------------------------------------------------------------
# 4. SMS GATEWAY CONFIGURATION (Optional: for real SMS to mobile numbers)
# ------------------------------------------------------------------------------
# Supported: 'fast2sms' (India) | 'twilio' (Global)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ------------------------------------------------------------------------------
# 4. OTP SECURITY & POLICY GATES
# ------------------------------------------------------------------------------
# Time-To-Live for 6-digit verification codes (in seconds, default: 300 = 5 minutes)
OTP_EXPIRES_SECONDS=300

# Maximum permitted incorrect OTP entry attempts before invalidation (default: 5)
OTP_MAX_ATTEMPTS=5

# Cooldown duration before user can request a resend (in seconds, default: 60)
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# 5. RATE LIMITING
# ------------------------------------------------------------------------------
# Maximum requests per 15-minute window for general API endpoints
RATE_LIMIT_MAX=300

# ------------------------------------------------------------------------------
# 6. AI COGNITIVE ORCHESTRATOR PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
# Default AI provider: 'local_heuristic' | 'gemini' | 'openai' | 'claude'
DEFAULT_AI_PROVIDER=local_heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
